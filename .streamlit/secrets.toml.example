# Streamlit Community Cloud Secrets Configuration Example
# Copy the appropriate section into Streamlit Community Cloud:
# App Settings -> Secrets (or into .streamlit/secrets.toml for local testing)

# =============================================================================
# OPTION 1: Aiven MySQL via SERVICE_URI (Recommended - 1 Click from Aiven)
# =============================================================================
# Copy directly from: Aiven Console -> Your MySQL Service -> Overview -> Service URI
#
# SERVICE_URI = "mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx.a.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# =============================================================================
# OPTION 2: Aiven MySQL via Individual Parameters
# =============================================================================
# Note: Always enclose DB_PASSWORD in single quotes ('...') so special characters
# like #, @, $, or \ are not parsed as TOML comments or escape characters!
#
# DB_HOST = "mysql-xxxx.a.aivencloud.com"
# DB_PORT = 12345                   # Aiven custom port (e.g. 10000-29999, NOT 3306)
# DB_USER = "avnadmin"
# DB_PASSWORD = 'YOUR_PASSWORD_HERE'
# DB_NAME = "defaultdb"             # Default Aiven DB (app will create vehicle_mgmt tables here or switch)
# DB_SSL = true
# DB_SSL_VERIFY_CERT = false

# =============================================================================
# OPTION 3: Generic / Other Cloud MySQL (AWS RDS, DigitalOcean, TiDB, Clever Cloud)
# =============================================================================
DB_HOST = "your-mysql-host.example.com"
DB_PORT = 3306
DB_USER = "your_mysql_username"
DB_PASSWORD = 'your_mysql_password'
DB_NAME = "vehicle_mgmt"

# Optional SSL Settings
# DB_SSL = true
# DB_SSL_VERIFY_CERT = false
# DB_SSL_CA = "path/to/ca.pem" # or paste full PEM certificate string
