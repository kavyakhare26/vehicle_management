# Streamlit Community Cloud Secrets Configuration Example
# Copy the lines below into Streamlit Community Cloud:
# App Settings -> Secrets (or into .streamlit/secrets.toml for local testing)

DB_HOST = "your-mysql-host.example.com"
DB_PORT = 3306
DB_USER = "your_mysql_username"
DB_PASSWORD = "your_mysql_password"
DB_NAME = "vehicle_mgmt"

# Optional SSL Settings (uncomment if required by cloud providers like TiDB, Aiven, PlanetScale, AWS RDS)
# DB_SSL = true
# DB_SSL_VERIFY_CERT = false
# DB_SSL_CA = "path/to/ca.pem"

# -----------------------------------------------------------------------------
# Alternative nested format (also supported):
# [mysql]
# host = "your-mysql-host.example.com"
# port = 3306
# user = "your_mysql_username"
# password = "your_mysql_password"
# database = "vehicle_mgmt"

